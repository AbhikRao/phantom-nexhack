# PHANTOM engine (no API keys are needed for anything)
PHANTOM_PORT=8787
PHANTOM_HOST=127.0.0.1
# State, traces, generated builds and REAL backend databases
PHANTOM_DATA_DIR=./.phantom
# Port the generated backend is launched on by the "Start generated backend" button
REAL_PORT=8788
# Extra browser origins allowed to call PHANTOM (comma-separated)
PHANTOM_ALLOWED_ORIGINS=
